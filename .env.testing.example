# Nastavenia pre `php artisan test` a `php artisan migrate:fresh --env=testing`.
# Skopírujte na .env.testing a doplňte APP_KEY (php artisan key:generate --env=testing).
#
# Tento súbor MUSÍ existovať. Bez neho `--env=testing` spadne späť na .env,
# teda na vývojovú databázu — a migrate:fresh ju zmaže.
#
# Databázu treba raz vytvoriť:
#   CREATE DATABASE hlascirkvi_test CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#
# Schéma sa stavia z database/schema/mysql-schema.sql (php artisan schema:dump),
# pretože migrácie zakladajúce väčšinu tabuliek v repozitári nikdy neboli.

APP_ENV=testing
APP_KEY=
APP_DEBUG=true

DB_CONNECTION=mysql
DB_HOST=localhost
DB_PORT=3306
DB_DATABASE=hlascirkvi_test
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=array
SESSION_DRIVER=array
QUEUE_CONNECTION=sync
MAIL_MAILER=array
MAIL_DRIVER=array
BCRYPT_ROUNDS=4
