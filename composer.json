{
    "name": "laravel/laravel",
    "type": "project",
    "description": "The Laravel Framework.",
    "keywords": [
        "framework",
        "laravel"
    ],
    "license": "MIT",
    "require": {
        "php": "^8.3",
        "alaouy/youtube": "^2.2.6",
        "guzzlehttp/guzzle": "^7.16.1",
        "intervention/image": "^4.4.1",
        "intervention/image-laravel": "^4.1.1",
        "laravel/framework": "^13.42",
        "laravel/sanctum": "^4.4",
        "laravel/socialite": "^5.32",
        "laravel/tinker": "^3.1",
        "laravel/ui": "^4.6.3",
        "openai-php/laravel": "^0.22.0",
        "spatie/laravel-permission": "^8.5"
    },
    "require-dev": {
        "barryvdh/laravel-debugbar": "^4.4.5",
        "barryvdh/laravel-ide-helper": "^3.8",
        "fakerphp/faker": "^1.24.1",
        "larastan/larastan": "^3.15",
        "laravel/pail": "^1.3",
        "laravel/pint": "^1.32.3",
        "laravel/sail": "^1.70",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.6",
        "phpunit/phpunit": "^13.4.7",
        "spatie/laravel-ignition": "^2.13"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": true
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "autoload": {
        "classmap": [
            "app/Models",
            "database"
        ],
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/"
        },
        "files": [
            "app/Http/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ],
        "analyse": "phpstan analyse --memory-limit=1G",
        "lint": "pint --dirty",
        "test": "@php artisan test"
    }
}
