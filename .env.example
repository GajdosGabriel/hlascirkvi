APP_NAME=Hlascirkvi
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://hlascirkvi.local

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hlascirkvi
DB_USERNAME=root
DB_PASSWORD=
# Cesta k mysqldump/mysql pre `php artisan schema:dump`. Na Windows s XAMPP-om
# binárky nie sú v PATH, napr. C:/xampp/mysql/bin/
DB_DUMP_BINARY_PATH=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
# Na produkcii zapnúť — cookie sa potom posiela len cez https.
SESSION_SECURE_COOKIE=false
SESSION_DOMAIN=

FILESYSTEM_DRIVER=local

# Domény, ktoré Sanctum obslúži cez session cookie (SPA na rovnakej doméne).
SANCTUM_STATEFUL_DOMAINS=

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=admin@hlascirkvi.sk
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

# Import videí z YouTube (App\Services\VideoUpload, príkazy
# UserSearchByChannelAndPlaylist a youtube:comments).
YOUTUBE_API_KEY=

# Prihlásenie cez Facebook (Laravel Socialite).
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=

# Rozpoznávanie dátumu a miesta v texte pozvánok.
OPENAI_API_KEY=
OPENAI_ORGANIZATION=

# Event portál — zdroj podujatí pre /akcie
EVENT_PORTAL_URL=https://event.hlascirkvi.sk
EVENT_PORTAL_TIMEOUT=8
EVENT_PORTAL_PER_PAGE=24
# Ako dlho sa drží odpoveď portálu; STALE_TTL je záložná kópia, z ktorej sa
# číta, keď je portál nedostupný.
EVENT_PORTAL_TTL_INDEX=300
EVENT_PORTAL_TTL_SHOW=600
EVENT_PORTAL_TTL_TAXONOMY=3600
EVENT_PORTAL_STALE_TTL=86400

# Obrázky (App\Services\Images\StoreImage). REMOTE_BASE je len pre vývoj —
# čo lokálne v úložisku chýba, dotiahne sa z produkcie. Na produkcii prázdne.
IMAGES_DISK=public
IMAGES_REMOTE_BASE=
IMAGES_JPEG_QUALITY=82
IMAGES_WEBP_QUALITY=80
IMAGES_MAX_PIXELS=40000000
IMAGES_FETCH_TIMEOUT=10
IMAGES_FETCH_RETRIES=2
IMAGES_FETCH_MAX_BYTES=15728640

# true = importované video sa zverejní hneď, false = ide do buffera a
# publisher ho vypustí počas dňa (App\Services\Buffer).
BUFFER_PUBLISH_ON_IMPORT=false

# SEO – kanonická doména webu (canonical, og:url, mapa webu). Bez nej sa
# berie APP_URL. Na produkcii musí byť ostrá doména aj so schémou.
SEO_URL=https://hlascirkvi.sk
SEO_SITE_NAME=
# ID Facebook aplikácie. Používa sa na troch miestach naraz: meta fb:app_id,
# FB.init v partials/analyticstracking a SDK skript na detaile príspevku.
SEO_FACEBOOK_APP_ID=
# Profily webu na sieťach; idú do schema.org ako sameAs.
SEO_FACEBOOK_PAGE=
SEO_YOUTUBE_CHANNEL=
# Účet na X v tvare @meno; prázdne = značka twitter:site sa nevykreslí.
SEO_TWITTER_SITE=
